# Environment Configuration for HITS AI Live
# Copy this file to .env and fill in the values.

# --- Gemini API ---
GEMINI_API_KEY=
GEMINI_MODEL_PARSER=
GEMINI_MODEL_PERSONA=
GEMINI_MODEL_SUPERVISOR=
GEMINI_MODEL_EMOTION=
GEMINI_MODEL_JUDGE=
GEMINI_MODEL_TTS=
GEMINI_RPM=5                # batas request/menit per model Gemini

# --- TTS ---
TTS_PROVIDER=edge          # gemini | elevenlabs | edge | voicestudio
ELEVENLABS_API_KEY=
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_API_KEY=
VOICESTUDIO_MODEL=tts-1

# --- Modes ---
LLM_MODE=mock              # live | mock
TTS_MODE=mock              # live | mock
MUSIC_PROVIDER=mock        # mock | deezer

# --- Prompt profile & sampling (PRD v1.1) ---
PROMPT_PROFILE=baseline_v1   # baseline_v1 | natural_v2
PERSONA_TEMPERATURE=0.7
PERSONA_TOP_P=0              # 0 = not sent to model
PERSONA_PRESENCE_PENALTY=0   # 0 = not sent to model
PERSONA_FREQUENCY_PENALTY=0  # 0 = not sent to model

# --- Testing ---
FAIL_INJECT=               # llm | tts | music (untuk uji fallback)

# --- Rekomendasi lagu (hits_rec) ---
RECOMMENDER_ENABLED=false
RECOMMENDER_LLM_API_KEY=
RECOMMENDER_LLM_BASE_URL=https://api.groq.com/openai/v1
RECOMMENDER_LLM_MODEL=qwen/qwen3.8-27b
RECOMMENDER_LLM_REASONING_EFFORT=
RECOMMENDER_TIMEOUT_SEC=8
RECOMMENDER_MAX_PENDING=5
RECOMMENDER_TALK_MOOD=false
RECOMMENDER_LLM_CACHE=false
